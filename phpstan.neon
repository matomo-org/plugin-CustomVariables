parameters:
    level: 5
    phpVersion: 70200
    tmpDir: /tmp/phpstan/CustomVariables/main
    paths:
        - .
    excludePaths:
        analyseAndScan:
            - tests/*
            # The shared workflow leaves this helper checkout in the workspace, and `paths: .`
            # would otherwise analyse it as if it were plugin code.
            - github-action-tests/*
    ignoreErrors:
        # Row::setColumn() and deleteColumn() are untyped and only document `@param string`, while
        # archiving addresses columns by the integer Metrics::INDEX_* constants throughout. Pinned
        # to the five call sites that do so, so a sixth has to be looked at rather than absorbed.
        -
            identifier: argument.type
            message: '#Row::(setColumn|deleteColumn)\(\) expects string, int given#'
            path: RecordBuilders/CustomVariables.php
            count: 5
        # The 5.2.0-b6 version guard reads as decided against whichever Matomo 5 is analysed, but
        # it is load-bearing across the 5.x line. phpstan-min-matomo.neon covers it as always
        # false, so this entry must not be reported as unmatched on that leg.
        -
            identifier: ternary.alwaysTrue
            path: RecordBuilders/CustomVariables.php
            count: 1
            reportUnmatched: false
    bootstrapFiles:
        - ../../bootstrap-phpstan.php
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
    scanDirectories:
        - ../../
